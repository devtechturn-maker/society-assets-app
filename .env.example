# Copy to ".env" on the local branch (gitignored; excluded from EAS uploads via .easignore).
#
# Android emulator on the same PC:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#
# Physical phone on same Wi‑Fi (ipconfig → Wi-Fi IPv4):
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:8080
# EXPO_PUBLIC_WEB_URL=http://192.168.1.XX:4200

# Push notifications (real device builds):
# EXPO_PUBLIC_EAS_PROJECT_ID=74744562-179c-4936-922f-b0b8c027965b
