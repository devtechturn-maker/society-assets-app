# Copy to ".env" for local development (gitignored).
# Android emulator on the same PC can omit .env (default http://10.0.2.2:8080).
# Physical phone: use your PC's LAN IP (ipconfig → Wi-Fi IPv4).

EXPO_PUBLIC_API_URL=http://192.168.1.XX:8080
EXPO_PUBLIC_WEB_URL=http://192.168.1.XX:4200

# Push notifications (real device builds):
# 1. npx eas-cli login
# 2. npx eas-cli init
# 3. Paste the project UUID below, then: npx expo start -c
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
