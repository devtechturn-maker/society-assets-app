# Copy to ".env" on the local branch (gitignored; excluded from EAS via .easignore).
# This file stays on local branch only — merging local → development keeps development URLs.

# Physical phone on same Wi‑Fi (your PC IPv4):
EXPO_PUBLIC_API_URL=http://172.20.10.3:8080
EXPO_PUBLIC_WEB_URL=http://172.20.10.3:4200

# Android emulator on the same PC:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# iOS Simulator / Metro on same PC:
# EXPO_PUBLIC_API_URL=http://localhost:8080
# EXPO_PUBLIC_WEB_URL=http://localhost:4200

# App store links (used when chairman shares society join code via WhatsApp/SMS)
EXPO_PUBLIC_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.devtechturn.societyassets
# Replace with your live App Store URL after publishing (e.g. .../id1234567890)
EXPO_PUBLIC_IOS_STORE_URL=https://apps.apple.com/search?term=Society+Assets
# Optional YouTube link for join/login guide in shared join-code message
# EXPO_PUBLIC_JOIN_GUIDE_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
