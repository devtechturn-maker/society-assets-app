{
  "name": "society-assets-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "theme:sync": "node ../shared/theme/emit-scss.mjs",
    "sync:icon": "node scripts/sync-app-icon.mjs",
    "build:splash": "node scripts/build-splash-assets.mjs",
    "prestart": "npm run theme:sync && npm run sync:icon && npm run build:splash",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:clear": "expo start --dev-client --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:lan": "expo start --dev-client --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios:dev": "node scripts/ensure-development-branch.mjs && eas build --profile development --platform ios",
    "build:android:dev": "node scripts/ensure-development-branch.mjs && eas build --profile development --platform android",
    "build:ios:sim": "node scripts/ensure-development-branch.mjs && eas build --profile development-simulator --platform ios",
    "web": "expo start --web",
    "test": "jest",
    "test:chat": "jest --testPathPatterns=tests/chat",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.15.2",
    "expo": "~54.0.35",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "jest-expo": "~54.0.0",
    "node-forge": "^1.4.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
