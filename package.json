{
  "name": "society-assets-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "theme:sync": "node ../shared/theme/emit-scss.mjs",
    "sync:icon": "node scripts/sync-app-icon.mjs",
    "build:splash": "node scripts/build-splash-assets.mjs",
    "prestart": "npm run theme:sync && npm run sync:icon && npm run build:splash",
    "start": "expo start --go",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "start:clear": "expo start --go --clear",
    "start:tunnel": "expo start --go --tunnel",
    "start:lan": "expo start --go --lan",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios:dev": "node scripts/ensure-development-branch.mjs && eas build --profile development --platform ios",
    "build:android:dev": "node scripts/ensure-development-branch.mjs && eas build --profile development --platform android",
    "build:ios:sim": "node scripts/ensure-development-branch.mjs && eas build --profile development-simulator --platform ios",
    "web": "expo start --web",
    "test": "jest",
    "test:chat": "jest --testPathPatterns=tests/chat",
    "test:watch": "jest --watch",
    "build:ios:preview": "node scripts/ensure-development-branch.mjs && eas build --profile preview --platform ios",
    "build:android:preview": "node scripts/ensure-development-branch.mjs && eas build --profile preview --platform android",
    "build:android:preview-apk": "node scripts/ensure-development-branch.mjs && eas build --profile preview-apk --platform android",
    "build:preview": "node scripts/ensure-development-branch.mjs && eas build --profile preview --platform all",
    "submit:ios:preview": "eas submit --profile preview --platform ios --latest",
    "submit:android:preview": "eas submit --profile preview --platform android --latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.15.2",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.16",
    "jest-expo": "~57.0.5",
    "node-forge": "^1.4.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
